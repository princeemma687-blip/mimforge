# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Tooling caches
.pytest_cache/
# Written by every `--self-test` run into its working directory
# (the frozen-app gate's on-disk evidence); a runtime artefact.
self-test-report.txt
.mypy_cache/
.ruff_cache/
.tox/
.coverage
htmlcov/

# Packaging (PyInstaller / Inno Setup output)
*.spec.bak
installer-output/
*.msi
*.exe

# Environment / secrets — NEVER commit keys or local config
.env
.env.*
!.env.example
firebase-service-account*.json
*firebase-adminsdk*.json
*.key
*.pem
signing-keys/

# Local project data (source of truth is the user's machine, not git)
data/
projects/
media/
recordings/

# Raw demonstration videos and audio (large; shared as signed packages, not git)
*.mp4

# Experiment run artefacts (regenerated by experiments/*/run_*.py)
experiments/**/output/*.mov
*.mkv
*.webm
*.wav
*.mp3

# Downloaded model weights (pinned + hashed in docs/SBOM.md; fetched by setup)
models/
*.onnx
*.gguf
*.task
*.tflite

# Stage 0 bundled runtime assets, staged at packaging time by
# setup/fetch_bundled_assets.py (ffmpeg binaries, model weights,
# the generated Firebase config resource, licence texts). Produced
# fresh by every packaging run; never committed.
bundled/
bundled-work/

# QNX SDP install + build output (installed locally via QNX Everywhere)
qnx-sdk/
qnx-build/

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini
*.flac
